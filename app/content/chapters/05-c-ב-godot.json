            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "textAlign": "right",
                  "dir": null
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "using godot"
                  },
                  {
                    "type": "text",
                    "text": " - מייבא את ה-"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Namespace"
                  },
                  {
                    "type": "text",
                    "text": " הייעודי "
