                    "type": "text",
                    "text": " ועוד."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "textAlign": "right",
                  "dir": null
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "שלב קומפליציה"
                  },
                  {
                    "type": "text",
                    "text": " - בניגוד ל-"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "GDScript"
                  },
                  {
                    "type": "text",
                    "text": ", שפת "
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "#C"
                  },
                  {
                    "type": "text",
                    "text": " צריכה “"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "להתקמפל"
                  },
                  {
                    "type": "text",
                    "text": "” לפני ההרצה. כלומר שכאשר אנחנו בונים ("
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Build"
                  },
                  {
                    "type": "text",
                    "text": ") את הפרויקט - הקוד מתורגם/מפורש לשפת ביניים (בקובץ "
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "DLL."
                  },
                  {
                    "type": "text",
                    "text": "), ולאחר מכן בהרצה קובץ ה-"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "DLL."
                  },
                  {
                    "type": "text",
                    "text": " יתורגם לשפת מכונה. אם יש שגיאות קומפילציה - התוכנית לא תרוץ, וזה יתרון ענק שעוזר לנו “לעלות” על שגיאות טרם ההרצה."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "textAlign": "right",
          "dir": null
        }
      },
      {
        "type": "heading",
        "attrs": {
          "textAlign": "right",
          "dir": null,
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "סקריפטים “מוצמדים” ל-Nodes"
          }
